                                    <span>Inspect wiring in Unit C</span>
                                    <span class="status status-complete">Complete</span>
                                </div>
                                <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem; background: rgba(0, 255, 150, 0.08); border-radius: 4px; border-left: 3px solid #00ff96;">
                                    <span>Calibrate sensors</span>
                                    <span class="status status-pending">Pending</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <script>
        // Configuration
        const SHEET_ID = 'weekly_repair_db';
        const API_KEY = 'https://script.google.com/macros/s/AKfycbzgmUojaS5IHh_3UsZPUz4Lj7lrMLBU9vzhcnqtmRNbXiNlt77a7n0w2T4gZx9F5fgSvw/exec';
        const SHEET_NAME = 'Sheet1';

        // Utility Functions
        function getToday() {
            return new Date();
        }

        function getWeekNumber(date) {
            const d = new Date(Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()));
            const dayNum = d.getUTCDay() || 7;
            d.setUTCDate(d.getUTCDate() + 4 - dayNum);
            const yearStart = new Date(Date.UTC(d.getUTCFullYear(), 0, 1));
            return Math.ceil((((d - yearStart) / 86400000) + 1) / 7);
        }

        function getWeekRange(date) {
            const day = date.getDay();
            const diff = date.getDate() - day + (day === 0 ? -6 : 1);
            const saturday = new Date(date.setDate(diff - 1));
            const friday = new Date(saturday);
            friday.setDate(friday.getDate() + 6);
            return { saturday, friday };
        }

        function formatDate(date) {
            return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
        }

        function getStatusBadge(status) {
            const statusLower = (status || '').toLowerCase().trim();
            if (statusLower === 'complete' || statusLower === 'completed') {
                return '<span class="status status-complete">Complete</span>';
            } else if (statusLower === 'in progress' || statusLower === 'inprogress') {
                return '<span class="status status-inprogress">In Progress</span>';
            } else if (statusLower === 'pending') {
                return '<span class="status status-pending">Pending</span>';
            }
            return `<span>${status || '-'}</span>`;
        }

        // Display today's date
        function displayToday() {
            const today = getToday();
            const weekRange = getWeekRange(new Date(today));
            document.getElementById('today-date').value = 
                `Today: ${formatDate(today)} (Week ${getWeekNumber(today)}, ${formatDate(weekRange.saturday)} - ${formatDate(weekRange.friday)})`;
        }

        // Fetch data
        async function fetchRepairData() {
            try {
                if (SHEET_ID === 'YOUR_SHEET_ID' || API_KEY === 'YOUR_API_KEY') {
                    console.warn('Please configure Sheet ID and API Key');
                    return [];
                }

                const url = `https://sheets.googleapis.com/v4/spreadsheets/${SHEET_ID}/values/${SHEET_NAME}?key=${API_KEY}`;
                const response = await fetch(url);

                if (!response.ok) throw new Error('Failed to fetch');

                const data = await response.json();
                return data.values || [];
            } catch (error) {
                console.error('Error:', error);
                return [];
            }
        }

        function populateWeekFilter(rows) {
            const weeks = new Set();
            rows.forEach((row, idx) => {
                if (idx === 0) return;
                const dateStr = row[2];
                if (dateStr) {
                    try {
                        const date = new Date(dateStr);
                        weeks.add(getWeekNumber(date));
                    } catch (e) {}
                }
            });

            const selectEl = document.getElementById('week-filter');
            Array.from(weeks)
                .sort((a, b) => b - a)
                .forEach(week => {
                    const option = document.createElement('option');
                    option.value = week;
                    option.textContent = `Week ${week}`;
                    selectEl.appendChild(option);
                });

            const currentWeek = getWeekNumber(getToday());
            selectEl.value = currentWeek;
        }

        function renderTable(rows, selectedWeek) {
            const tbody = document.getElementById('table-body');
            const filtered = rows
                .slice(1)
                .filter(row => {
                    if (!selectedWeek) return true;
                    const dateStr = row[2];
                    return dateStr ? getWeekNumber(new Date(dateStr)) == selectedWeek : false;
                });

            if (filtered.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" style="text-align: center; padding: 2rem;">No repairs scheduled</td></tr>';
                updateStats(rows, selectedWeek);
                return;
            }

            const tableBody = filtered.map(row => {
                const [unitNo, repairType, date, duration, location, status, remarks] = row;
                return `
                    <tr>
                        <td>${unitNo || '-'}</td>
                        <td>${repairType || '-'}</td>
                        <td>${duration || '-'}</td>
                        <td>${location || '-'}</td>
                        <td>${getStatusBadge(status)}</td>
                        <td>${remarks || '-'}</td>
                    </tr>
                `;
            });

            tbody.innerHTML = tableBody.join('');
            updateStats(rows, selectedWeek);
        }

        function updateStats(rows, selectedWeek) {
            const filtered = rows.slice(1).filter(row => {
                if (!selectedWeek) return true;
                const dateStr = row[2];
                return dateStr ? getWeekNumber(new Date(dateStr)) == selectedWeek : false;
            });

            const total = filtered.length;
            const completed = filtered.filter(r => (r[5] || '').toLowerCase().includes('complete')).length;
            const inProgress = filtered.filter(r => (r[5] || '').toLowerCase().includes('progress')).length;
            const pending = filtered.filter(r => (r[5] || '').toLowerCase().includes('pending')).length;

            document.getElementById('stat-total').textContent = total;
            document.getElementById('stat-complete').textContent = completed;
            document.getElementById('stat-progress').textContent = inProgress;
            document.getElementById('stat-pending').textContent = pending;
        }

        // Initialize
        async function init() {
            displayToday();
            const rows = await fetchRepairData();

            if (rows.length > 1) {
                populateWeekFilter(rows);
                const currentWeek = getWeekNumber(getToday());
                renderTable(rows, currentWeek);

                document.getElementById('week-filter').addEventListener('change', (e) => {
                    const selectedWeek = e.target.value ? parseInt(e.target.value) : null;
                    renderTable(rows, selectedWeek);
                });
            }
        }

        document.addEventListener('DOMContentLoaded', init);
    </script>
</body>
</html>
