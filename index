<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Repair Management System</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', sans-serif;
            background: #0a0e27;
            color: #e0e0e0;
            overflow-x: hidden;
        }

        /* Grid Background Pattern */
        .grid-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: 
                linear-gradient(0deg, transparent 24%, rgba(0, 255, 150, 0.08) 25%, rgba(0, 255, 150, 0.08) 26%, transparent 27%, transparent 74%, rgba(0, 255, 150, 0.08) 75%, rgba(0, 255, 150, 0.08) 76%, transparent 77%, transparent),
                linear-gradient(90deg, transparent 24%, rgba(0, 255, 150, 0.08) 25%, rgba(0, 255, 150, 0.08) 26%, transparent 27%, transparent 74%, rgba(0, 255, 150, 0.08) 75%, rgba(0, 255, 150, 0.08) 76%, transparent 77%, transparent);
            background-size: 60px 60px;
            pointer-events: none;
            z-index: 1;
        }

        /* Gradient Overlay */
        .gradient-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at 20% 50%, rgba(0, 255, 150, 0.05) 0%, transparent 50%);
            pointer-events: none;
            z-index: 1;
        }

        .container {
            position: relative;
            z-index: 2;
        }

        /* Navbar */
        .navbar {
            background: rgba(10, 14, 39, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(0, 255, 150, 0.2);
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 20px;
            font-weight: 700;
            color: #00ff96;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .logo::before {
            content: '';
            width: 30px;
            height: 30px;
            background: linear-gradient(135deg, #00ff96, #00cc7a);
            clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 50%, 0 100%);
        }

        .nav-links {
            display: flex;
            gap: 2rem;
            align-items: center;
        }

        .nav-links a {
            color: #a0a0a0;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: color 0.3s;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .nav-links a:hover {
            color: #00ff96;
        }

        .nav-buttons {
            display: flex;
            gap: 1rem;
            align-items: center;
        }

        .btn-secondary {
            padding: 0.5rem 1.5rem;
            background: transparent;
            border: 1px solid rgba(0, 255, 150, 0.5);
            color: #00ff96;
            border-radius: 4px;
            cursor: pointer;
            font-size: 13px;
            font-weight: 600;
            transition: all 0.3s;
        }

        .btn-secondary:hover {
            border-color: #00ff96;
            box-shadow: 0 0 10px rgba(0, 255, 150, 0.3);
        }

        .btn-primary {
            padding: 0.5rem 1.5rem;
            background: #00ff96;
            border: none;
            color: #0a0e27;
            border-radius: 4px;
            cursor: pointer;
            font-size: 13px;
            font-weight: 600;
            transition: all 0.3s;
        }

        .btn-primary:hover {
            background: #00cc7a;
            box-shadow: 0 0 20px rgba(0, 255, 150, 0.5);
        }

        /* Hero Section */
        .hero {
            text-align: center;
            padding: 6rem 2rem;
            position: relative;
            z-index: 2;
        }

        .hero h1 {
            font-size: 3.5rem;
            font-weight: 700;
            margin-bottom: 1rem;
            line-height: 1.2;
            background: linear-gradient(135deg, #ffffff, #00ff96);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero p {
            font-size: 1.1rem;
            color: #a0a0a0;
            margin-bottom: 2rem;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }

        .hero-buttons {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
        }

        /* Dashboard Section */
        .dashboard-section {
            max-width: 1400px;
            margin: 0 auto;
            padding: 2rem;
            position: relative;
            z-index: 2;
        }

        .dashboard-grid {
            display: grid;
            grid-template-columns: 250px 1fr;
            gap: 2rem;
            margin-top: 2rem;
        }

        /* Sidebar */
        .sidebar {
            background: rgba(20, 25, 50, 0.8);
            border: 1px solid rgba(0, 255, 150, 0.2);
            border-radius: 8px;
            padding: 1.5rem;
            backdrop-filter: blur(10px);
            height: fit-content;
        }

        .sidebar-title {
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #00ff96;
            margin-bottom: 1rem;
            font-weight: 700;
        }

        .sidebar-item {
            padding: 0.75rem 1rem;
            margin-bottom: 0.5rem;
            background: rgba(0, 255, 150, 0.1);
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 13px;
            color: #a0a0a0;
            border-left: 3px solid transparent;
        }

        .sidebar-item:hover,
        .sidebar-item.active {
            background: rgba(0, 255, 150, 0.2);
            border-left-color: #00ff96;
            color: #00ff96;
        }

        /* Main Content */
        .main-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
        }

        .card {
            background: rgba(20, 25, 50, 0.8);
            border: 1px solid rgba(0, 255, 150, 0.2);
            border-radius: 8px;
            padding: 2rem;
            backdrop-filter: blur(10px);
            transition: all 0.3s;
        }

        .card:hover {
            border-color: rgba(0, 255, 150, 0.5);
            box-shadow: 0 0 20px rgba(0, 255, 150, 0.1);
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
            border-bottom: 1px solid rgba(0, 255, 150, 0.2);
            padding-bottom: 1rem;
        }

        .card-title {
            font-size: 14px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #ffffff;
        }

        .card-subtitle {
            font-size: 12px;
            color: #a0a0a0;
            margin-top: 0.25rem;
        }

        .toggle-switch {
            width: 40px;
            height: 24px;
            background: rgba(0, 255, 150, 0.2);
            border: 1px solid rgba(0, 255, 150, 0.3);
            border-radius: 12px;
            cursor: pointer;
            display: flex;
            align-items: center;
            padding: 2px;
            transition: all 0.3s;
        }

        .toggle-switch.active {
            background: #00ff96;
        }

        .toggle-dot {
            width: 20px;
            height: 20px;
            background: rgba(20, 25, 50, 0.9);
            border-radius: 10px;
            transition: all 0.3s;
        }

        .toggle-switch.active .toggle-dot {
            transform: translateX(16px);
            background: #0a0e27;
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .stat-box {
            background: rgba(0, 255, 150, 0.05);
            border: 1px solid rgba(0, 255, 150, 0.2);
            padding: 1.5rem;
            border-radius: 6px;
            text-align: center;
        }

        .stat-number {
            font-size: 32px;
            font-weight: 700;
            color: #00ff96;
            margin-bottom: 0.5rem;
        }

        .stat-label {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #a0a0a0;
        }

        /* Table */
        .table-wrapper {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

        thead {
            background: rgba(0, 255, 150, 0.05);
        }

        th {
            padding: 1rem;
            text-align: left;
            font-weight: 700;
            color: #00ff96;
            text-transform: uppercase;
            font-size: 11px;
            letter-spacing: 1px;
            border-bottom: 1px solid rgba(0, 255, 150, 0.2);
        }

        td {
            padding: 1rem;
            border-bottom: 1px solid rgba(0, 255, 150, 0.1);
            color: #a0a0a0;
        }

        tbody tr:hover {
            background: rgba(0, 255, 150, 0.05);
        }

        /* Status Badge */
        .status {
            display: inline-block;
            padding: 0.35rem 0.75rem;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .status-complete {
            background: rgba(0, 255, 150, 0.2);
            color: #00ff96;
            border: 1px solid rgba(0, 255, 150, 0.4);
        }

        .status-pending {
            background: rgba(255, 180, 0, 0.2);
            color: #ffb400;
            border: 1px solid rgba(255, 180, 0, 0.4);
        }

        .status-inprogress {
            background: rgba(100, 200, 255, 0.2);
            color: #64c8ff;
            border: 1px solid rgba(100, 200, 255, 0.4);
        }

        /* Chart */
        .chart-container {
            display: flex;
            align-items: flex-end;
            justify-content: space-around;
            height: 200px;
            gap: 1rem;
        }

        .chart-bar {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.5rem;
        }

        .bar {
            background: linear-gradient(180deg, #00ff96, #00cc7a);
            border-radius: 4px;
            width: 40px;
            min-height: 20px;
            transition: all 0.3s;
            box-shadow: 0 0 10px rgba(0, 255, 150, 0.3);
        }

        .bar:hover {
            box-shadow: 0 0 20px rgba(0, 255, 150, 0.6);
        }

        .bar-label {
            font-size: 12px;
            color: #a0a0a0;
        }

        /* Modal/Filter */
        .filter-section {
            display: flex;
            gap: 1rem;
            margin-bottom: 1.5rem;
            align-items: center;
        }

        .select-input {
            padding: 0.5rem 1rem;
            background: rgba(0, 255, 150, 0.1);
            border: 1px solid rgba(0, 255, 150, 0.3);
            border-radius: 4px;
            color: #00ff96;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.3s;
        }

        .select-input:hover,
        .select-input:focus {
            border-color: #00ff96;
            box-shadow: 0 0 10px rgba(0, 255, 150, 0.2);
            outline: none;
        }

        .select-input option {
            background: #0a0e27;
            color: #00ff96;
        }

        /* Responsive */
        @media (max-width: 1200px) {
            .main-content {
                grid-template-columns: 1fr;
            }

            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .hero h1 {
                font-size: 2.5rem;
            }
        }

        @media (max-width: 768px) {
            .dashboard-grid {
                grid-template-columns: 1fr;
            }

            .nav-links {
                gap: 1rem;
                font-size: 12px;
            }

            .hero h1 {
                font-size: 2rem;
            }

            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .navbar {
                flex-direction: column;
                gap: 1rem;
            }
        }

        @media (max-width: 640px) {
            .hero {
                padding: 3rem 1rem;
            }

            .hero h1 {
                font-size: 1.8rem;
            }

            .stats-grid {
                grid-template-columns: 1fr;
            }

            .sidebar {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="grid-background"></div>
    <div class="gradient-overlay"></div>

    <div class="container">
        <!-- Navbar -->
        <nav class="navbar">
            <div class="logo">Repair Hub</div>
            <div class="nav-links">
                <a href="#home">Home</a>
                <a href="#repairs">Repairs</a>
                <a href="#reports">Reports</a>
                <a href="#settings">Settings</a>
            </div>
            <div class="nav-buttons">
                <button class="btn-secondary">Login</button>
                <button class="btn-primary">Sign up</button>
            </div>
        </nav>

        <!-- Hero Section -->
        <section class="hero">
            <h1>Manage repairs efficiently.<br>Track everything in one place.</h1>
            <p>Organize tasks, track progress, and keep every repair on schedule. Keep your team aligned, informed, and moving forward.</p>
            <div class="hero-buttons">
                <button class="btn-primary">Get Started</button>
                <button class="btn-secondary">View Demo</button>
            </div>
        </section>

        <!-- Dashboard Section -->
        <section class="dashboard-section">
            <div class="dashboard-grid">
                <!-- Sidebar -->
                <div class="sidebar">
                    <div class="sidebar-title">Dashboard</div>
                    <div class="sidebar-item active">Overview</div>
                    <div class="sidebar-item">Today's Tasks</div>
                    <div class="sidebar-item">This Week</div>
                    <div class="sidebar-item">Pending</div>
                    <div class="sidebar-item">Completed</div>
                    <div class="sidebar-item">Reports</div>
                    <hr style="border: none; border-top: 1px solid rgba(0, 255, 150, 0.1); margin: 1rem 0;">
                    <div class="sidebar-title" style="margin-top: 1rem;">Locations</div>
                    <div class="sidebar-item">Zone A</div>
                    <div class="sidebar-item">Zone B</div>
                    <div class="sidebar-item">Zone C</div>
                </div>

                <!-- Main Content -->
                <div>
                    <!-- Stats Grid -->
                    <div class="stats-grid">
                        <div class="stat-box">
                            <div class="stat-number" id="stat-total">0</div>
                            <div class="stat-label">Total</div>
                        </div>
                        <div class="stat-box">
                            <div class="stat-number" id="stat-complete">0</div>
                            <div class="stat-label">Completed</div>
                        </div>
                        <div class="stat-box">
                            <div class="stat-number" id="stat-progress">0</div>
                            <div class="stat-label">In Progress</div>
                        </div>
                        <div class="stat-box">
                            <div class="stat-number" id="stat-pending">0</div>
                            <div class="stat-label">Pending</div>
                        </div>
                    </div>

                    <!-- Cards Row -->
                    <div class="main-content">
                        <!-- Repairs Table Card -->
                        <div class="card" style="grid-column: 1 / -1;">
                            <div class="card-header">
                                <div>
                                    <div class="card-title">Weekly Repairs</div>
                                    <div class="card-subtitle">This week's scheduled repairs</div>
                                </div>
                                <div style="display: flex; gap: 1rem; align-items: center;">
                                    <select class="select-input" id="week-filter">
                                        <option>Select week</option>
                                    </select>
                                    <div class="toggle-switch active">
                                        <div class="toggle-dot"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="filter-section">
                                <input type="text" id="today-date" readonly style="padding: 0.5rem; background: rgba(0, 255, 150, 0.1); border: 1px solid rgba(0, 255, 150, 0.3); border-radius: 4px; color: #00ff96; font-size: 12px;">
                            </div>
                            <div class="table-wrapper">
                                <table id="repair-table">
                                    <thead>
                                        <tr>
                                            <th>Unit No</th>
                                            <th>Repair Type</th>
                                            <th>Duration</th>
                                            <th>Location</th>
                                            <th>Status</th>
                                            <th>Remarks</th>
                                        </tr>
                                    </thead>
                                    <tbody id="table-body">
                                        <tr><td colspan="6" style="text-align: center; padding: 2rem;">Loading data...</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Performance Card -->
                        <div class="card">
                            <div class="card-header">
                                <div>
                                    <div class="card-title">Performance</div>
                                    <div class="card-subtitle">Completion rate</div>
                                </div>
                            </div>
                            <div class="chart-container">
                                <div class="chart-bar">
                                    <div class="bar" style="height: 80%;"></div>
                                    <span class="bar-label">Mon</span>
                                </div>
                                <div class="chart-bar">
                                    <div class="bar" style="height: 60%;"></div>
                                    <span class="bar-label">Tue</span>
                                </div>
                                <div class="chart-bar">
                                    <div class="bar" style="height: 90%;"></div>
                                    <span class="bar-label">Wed</span>
                                </div>
                                <div class="chart-bar">
                                    <div class="bar" style="height: 70%;"></div>
                                    <span class="bar-label">Thu</span>
                                </div>
