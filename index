                        </div>

                        <!-- Tasks Card -->
                        <div class="card">
                            <div class="card-header">
                                <div>
                                    <div class="card-title">Today's Tasks</div>
                                    <div class="card-subtitle">4 repairs scheduled</div>
                                </div>
                            </div>
                            <div style="display: flex; flex-direction: column; gap: 1rem;">
                                <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem; background: rgba(0, 255, 150, 0.08); border-radius: 4px; border-left: 3px solid #00ff96;">
                                    <span>Fix pump in Unit A</span>
                                    <span class="status status-inprogress">In Progress</span>
                                </div>
                                <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem; background: rgba(0, 255, 150, 0.08); border-radius: 4px; border-left: 3px solid #00ff96;">
